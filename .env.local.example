# ──────────────────────────────────────────────────────────────────────────────
#  OmniRoute — Local Deployment .env
#  Used by: docker-compose.local.yml
#
#  Copy to .env and fill in REAL values (see server.env in your data volume):
#    cp .env.local.example .env
#
#  NEVER commit .env to git.
# ──────────────────────────────────────────────────────────────────────────────

# ── Required secrets (must match existing data volume!) ────────────────────
# These must be IDENTICAL to the values in your old server.env / data volume,
# or your existing encrypted data will be unreadable.
# Copy exact values from: docker run --rm -v omniroute-data:/d alpine:3.21 cat /d/server.env

JWT_SECRET=your-jwt-secret-here
API_KEY_SECRET=your-api-key-secret-here
STORAGE_ENCRYPTION_KEY=your-storage-encryption-key-here
STORAGE_ENCRYPTION_KEY_VERSION=v1

# ── Server config ───────────────────────────────────────────────────────────
PORT=20128
DASHBOARD_PORT=20128
API_PORT=20129
LIVE_WS_PORT=20132
LIVE_WS_HOST=0.0.0.0
LIVE_WS_ALLOWED_ORIGINS=http://localhost:20128,http://127.0.0.1:20128
API_HOST=0.0.0.0

# ── Memory / Qdrant ─────────────────────────────────────────────────────────
# OmniRoute resolves these via the service name on the internal Docker network.
# You can also configure Qdrant via the dashboard → Settings → Memory.
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_COLLECTION=omniroute_memory
# QDRANT_API_KEY=        # leave blank for local unauthenticated Qdrant

# ── Optional: initial admin password (only used on first boot) ──────────────
# If you already have an account in the restored database, this has no effect.
# INITIAL_PASSWORD=CHANGEME

# ── Optional: Node memory ceiling ───────────────────────────────────────────
# OMNIROUTE_MEMORY_MB=1024
